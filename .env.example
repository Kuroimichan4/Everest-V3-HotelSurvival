# Configuracion local opcional; las aplicaciones tienen valores por defecto.
HOST=127.0.0.1
PORT=3001
WEB_ORIGIN=http://localhost:5173
BACKEND_URL=http://127.0.0.1:3001

# NPC: modo predeterminado sin llamadas externas. Solo el servidor lee estas variables.
SURVIVOR_AI_MODE=demo
GEMINI_API_KEY=
# Modelo inicial con nivel gratuito según la documentación de Google; disponibilidad y cuotas dependen del proyecto.
GEMINI_MODEL=gemini-3.5-flash-lite
# Menor que el plazo de vigencia del agente (5 segundos).
SURVIVOR_AI_TIMEOUT_MS=2500
# Presupuesto total por partida, no por participante ni por reconexión (0-15).
SURVIVOR_AI_MAX_CALLS=15

# Ejemplo ficticio. No se utiliza hasta implementar la persistencia.
# Nunca poner credenciales reales en archivos versionados ni variables VITE_*.
DATABASE_URL=postgresql://placeholder:placeholder@127.0.0.1:5432/everest_placeholder?schema=public
